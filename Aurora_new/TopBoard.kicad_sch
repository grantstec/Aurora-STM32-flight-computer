		)
		(uuid "2c6ecca6-630d-48aa-ad41-ea4018261c8b")
	)
	(text "The 3.3 GPIO is connected to the gate of N-Channel AO3400A with 1k current limiting resistor\n3.3/1k = 3.3ma pulled from microncontroller GPIO when high it opens\nand connects the ground to the gate of the P-Channel AO3401A which creates a \nVgs difference from the 12 source opening the mosfet and powering the solenoid\nthe 10k pullup keeps that P-Channel Mosfet closed with Vgs = 0"
		(exclude_from_sim no)
		(at 119.38 164.846 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "63e81a21-ac1d-4d32-b0cf-312ec52e508b")
	)
	(text "Peripherals from bottom"
		(exclude_from_sim no)
		(at 75.946 19.304 0)
		(effects
			(font
				(size 6.35 6.35)
				(thickness 1.27)
				(bold yes)
			)
		)
		(uuid "7632c1ec-703a-48a6-82b8-579d12e7dc37")
	)
	(text "PYRO"
		(exclude_from_sim no)
		(at 192.024 80.772 0)
		(effects
			(font
				(size 6.35 6.35)
				(thickness 1.27)
				(bold yes)
			)
		)
		(uuid "7add3fd1-5fcd-4e54-aa16-32cde88a5f34")
	)
	(text "TEMP Sensor Breakout Connection"
		(exclude_from_sim no)
		(at 375.92 169.926 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
