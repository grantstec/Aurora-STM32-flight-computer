				(thickness 1.27)
				(bold yes)
			)
		)
		(uuid "1dcde983-96eb-4307-8042-391a30573fb0")
	)
	(text "MISC\n"
		(exclude_from_sim no)
		(at 342.392 152.908 0)
		(effects
