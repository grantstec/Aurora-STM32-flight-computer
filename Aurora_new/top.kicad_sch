	)
	(text "Solenoid\n"
		(exclude_from_sim no)
		(at 91.44 79.502 0)
		(effects
			(font
				(size 6.35 6.35)
				(thickness 1.27)
				(bold yes)
			)
		)
		(uuid "51737ba9-cee5-45c7-8068-6e2e63d7db98")
	)
	(text "The 3.3 GPIO is connected to the gate of N-Channel AO3400A with 1k current limiting resistor\n3.3/1k = 3.3ma pulled from microncontroller GPIO when high it opens\nand connects the ground to the gate of the P-Channel AO3401A which creates a \nVgs difference from the 12 source opening the mosfet and powering the solenoid\nthe 10k pullup keeps that P-Channel Mosfet closed with Vgs = 0. When 12v is outputed\nfrom the drain the diode prevents this from going back into the GPIO pin\nprotecting the microcontroller"
		(exclude_from_sim no)
		(at 219.964 166.878 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "54e1f039-3559-40d4-9ba2-fefaf29e3b57")
	)
	(text "---Continuity---\nThe continuity check works by the microcontroller sending a 3.3v GPIO HIGH\nwhich gets current limited by the 1k resistor and then if the ematch is connected\nit basically looks like a short circuit or a ground from diode cathode side\nso simplifies the ciruit to: 3.3v GPIO - 1k - ADC_CONT - Diode -GND \nthe ADC will read just the forward bias of the diode (~0.7v) as the rest \nof the voltage is dropped across the 1k resistor. When a ematch is not connected\nthe ADC reads the full 3.3 as there is no ground to drop any of the voltage across \nthe resistor. "
		(exclude_from_sim no)
		(at 219.456 185.674 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7e50014e-2740-4026-b75c-89cdd015b5f7")
	)
